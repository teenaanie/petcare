# Pippy — environment variables
#
#   cp .env.example .env     then fill in the values below
#
# For a deploy, the same names go in the host's dashboard:
#   Vercel  → Settings → Environment Variables → Production
#   Netlify → Site configuration → Environment variables
#
# ─────────────────────────────────────────────────────────────────────────────
# READ THIS FIRST: VITE_ variables are PUBLIC
#
# Vite inlines every VITE_* value into the JavaScript bundle at BUILD time.
# Anyone who opens the site can read them. That is fine for a Supabase anon
# key (it is designed to be public and is governed by row-level security) and
# it is NOT fine for anything that can spend money or read another user's data.
#
# Two consequences:
#   · Never put a secret behind a VITE_ prefix.
#   · Changing a VITE_ value has no effect until you REBUILD. Setting it in the
#     Vercel dashboard and restarting is not enough — trigger a redeploy.
# ─────────────────────────────────────────────────────────────────────────────


# ── Required: without these the app has no backend ───────────────────────────
#
# Leave them unset and src/lib/supabase.js exports a null client, which makes
# isConfigured false. The app then runs entirely on browser localStorage: it
# loads and looks healthy, but there is no login screen, no pets and no
# provider directory. That silent fallback is the most common deploy mistake
# here, so check these first if a deploy looks empty.
#
# Supabase → Project Settings → API
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key


# ── Required by the serverless functions in api/ ─────────────────────────────
#
# No VITE_ prefix, so these stay on the server and never reach the browser.
# The service key bypasses row-level security entirely — treat it like a
# database password.
#
# Supabase → Project Settings → API
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_KEY=your-service-role-key


# ── AI features (api/analyze-document.js, ai-complete.js, transcribe.js) ─────
#
# One key, used by every AI feature: document scanning, the health brief, the
# voice-to-reminder parse and voice transcription. It has no VITE_ prefix and
# must never be given one — see "Never do this" at the bottom of this file.
#
# platform.openai.com → API keys
OPENAI_API_KEY=sk-...

# Per-user monthly caps, so one account cannot run up the bill.
MONTHLY_SCAN_LIMIT=30
# Applies to the health brief, voice parsing and transcription, counted
# separately per feature.
MONTHLY_AI_LIMIT=100


# ── Morning reminders (api/morning-reminders.js, runs 07:00 IST) ─────────────
#
# Email — resend.com → API keys
RESEND_API_KEY=re_...
FROM_EMAIL=Pippy <reminders@yourdomain.com>

# SMS — twilio.com → Console
TWILIO_ACCOUNT_SID=AC...
TWILIO_AUTH_TOKEN=your-auth-token
TWILIO_PHONE_NUMBER=+1234567890

# Web push — generate a pair with:  npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=your-vapid-public-key
VAPID_PRIVATE_KEY=your-vapid-private-key
VAPID_SUBJECT=mailto:you@yourdomain.com


# ── Optional: client-side extras ─────────────────────────────────────────────
#
# The public half of the VAPID pair above. Public by design — it is what the
# browser uses to subscribe to push.
VITE_VAPID_PUBLIC_KEY=your-vapid-public-key

# EmailJS, for the "send this reminder now" button. These are publishable
# values; EmailJS expects them in client code.
VITE_EMAILJS_SERVICE_ID=service_xxx
VITE_EMAILJS_TEMPLATE_ID=template_xxx
VITE_EMAILJS_PUBLIC_KEY=your-emailjs-public-key


# ── Never do this ────────────────────────────────────────────────────────────
#
# Do not set VITE_OPENAI_API_KEY. Nothing reads it any more, and the VITE_
# prefix tells Vite to compile the value into the public bundle — setting it
# would publish your OpenAI key to anyone who views the site, billable to you
# per call.
#
# Every AI feature now goes through a serverless function that holds
# OPENAI_API_KEY, checks the caller's Supabase session and caps usage per user
# per month. The same rule applies to SUPABASE_SERVICE_KEY: server only.
